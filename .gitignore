# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Venv
Host/Python/meu_venv/*
# Node modules
Host/Frontend/node_modules/*
# Package_lock
Host/Frontend/package-lock.json
# Next Cache
Host/Frontend/.next

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
